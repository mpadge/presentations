// Street junction, drawn with: neato -n -Tsvg junction.dot -o junction.svg
// Node positions are pinned (points, y up). Start "s" sits directly below the
// junction "j"; the four terminals are spaced at 72 degrees, so that all five
// neighbours of "j" (including "s") are equally spaced in angle.
digraph junction {
  splines=line
  bgcolor=transparent
  node [shape=circle fixedsize=true width=0.7 height=0.7 fontname="Helvetica-Bold" fontsize=18
        style=filled fillcolor="#edf0fc" color="#1a3bbf" penwidth=2]
  edge [color="#1a3bbf" penwidth=2.5 arrowsize=1]

  lj [label="J" fillcolor="#ee8721" pos="250.0,300!"]
  ls [label="S" pos="250.0,130.0!"]
  le [label="E" pos="411.7,247.5!"]
  ln [label="N" pos="349.9,437.5!"]
  lw [label="W" pos="150.1,437.5!"]
  lx [label="X" pos="88.3,247.5!"]
  rj [label="J" fillcolor="#ee8721" pos="730.0,300!"]
  rs [label="S" pos="730.0,130.0!"]
  re [label="E" pos="891.7,247.5!"]
  rn [label="N" pos="829.9,437.5!"]
  rw [label="W" pos="630.1,437.5!"]
  rx [label="X" pos="568.3,247.5!"]

  // left panel: one edge in, four out
  ls -> lj [color="#444444" penwidth=5]
  lj -> le
  lj -> ln
  lj -> lw
  lj -> lx

  // right panel: shared start and junction. A grey line runs from s to j only;
  // each coloured path is one continuous curve from s, round j, to one terminal,
  // drawn as a chain of short edges through invisible waypoint nodes.
  rs -> rj [color="#444444"]

  // faint straight edges from j to each terminal, for reference
  rj -> re [color="#1a3bbf55" style=dashed arrowhead=none]
  rj -> rn [color="#1a3bbf55" style=dashed arrowhead=none]
  rj -> rw [color="#1a3bbf55" style=dashed arrowhead=none]
  rj -> rx [color="#1a3bbf55" style=dashed arrowhead=none]

  node [shape=point width=0.001 height=0.001 style=invis label=""]
  w_x1 [pos="713.6,164.6!"]
  w_x2 [pos="712.1,179.6!"]
  w_x3 [pos="711.0,195.2!"]
